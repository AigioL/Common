<Project>
	<PropertyGroup>
		<Version_OpenIddict>7.5.0</Version_OpenIddict>
		<Version_NET>10.0.11</Version_NET>
		<Version_NET Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">11.0.0-preview.7.26381.103</Version_NET>
		<Version_OpenApi>2.12.0</Version_OpenApi>
		<Version_OpenApi Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">3.10.0</Version_OpenApi>
	</PropertyGroup>
	<!-- 👇 Windows Only -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.298" />
		<PackageVersion Include="System.Management" Version="10.0.6" />
		<PackageVersion Include="WmiLight" Version="7.2.0" />
		<PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="$(Version_NET)" />
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(Version_NET)" />
		<PackageVersion Include="System.Drawing.Common" Version="$(Version_NET)" />
	</ItemGroup>
	<!-- 👇 WinUI3 -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
		<PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
	</ItemGroup>
	<!-- 👇 依赖注入 -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(Version_NET)" />
	</ItemGroup>
	<!-- 👇 日志 -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="$(Version_NET)" />
		<PackageVersion Include="Microsoft.Extensions.Logging.EventLog" Version="$(Version_NET)" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="$(Version_NET)" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(Version_NET)" />
		<PackageVersion Include="NLog" Version="6.1.4" />
		<PackageVersion Include="NLog.Extensions.Logging" Version="6.1.4" />
		<PackageVersion Include="NLog.Web.AspNetCore" Version="6.1.4" />
	</ItemGroup>
	<!-- 👇 xunit 单元测试 -->
	<ItemGroup>
		<PackageVersion Include="coverlet.collector" Version="10.0.1" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
		<PackageVersion Include="xunit.v3" Version="4.0.0" />
	</ItemGroup>
	<!-- 👇 哈希算法 -->
	<ItemGroup>
		<PackageVersion Include="System.IO.Hashing" Version="$(Version_NET)" />
	</ItemGroup>
	<!-- 👇 JsonWebToken -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
		<PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(Version_NET)" />
	</ItemGroup>
	<!-- 👇 可回收内存流 -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
	</ItemGroup>
	<!-- 👇 EF Core -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(Version_NET)" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(Version_NET)" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.6" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="$(Version_NET)" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Tasks" Version="$(Version_NET)" />
		<PackageVersion Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="$(Version_NET)" />
		<PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
		<PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.6" />
		<PackageVersion Include="EFCore.BulkExtensions.PostgreSql" Version="10.0.0" />
	</ItemGroup>
	<!-- 👇 序列化 -->
	<ItemGroup>
		<PackageVersion Include="MemoryPack" Version="1.21.4" />
		<PackageVersion Include="MemoryPack.Streaming" Version="1.21.4" />
	</ItemGroup>
	<!-- 👇 OpenApi -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(Version_NET)" />
		<PackageVersion Include="Microsoft.OpenApi" Version="$(Version_OpenApi)" />
		<PackageVersion Include="Scalar.AspNetCore" Version="2.16.20" />
	</ItemGroup>
	<!-- 👇 ExternalLogin 外部账号登录 -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="$(Version_NET)" />
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.Facebook" Version="$(Version_NET)" />
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.Twitter" Version="$(Version_NET)" />
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="$(Version_NET)" />
		<PackageVersion Include="AspNet.Security.OAuth.Apple" Version="10.0.0" />
		<PackageVersion Include="AspNet.Security.OAuth.Weixin" Version="10.0.0" />
		<PackageVersion Include="AspNet.Security.OAuth.QQ" Version="10.0.0" />
		<PackageVersion Include="AspNet.Security.OAuth.Alipay" Version="10.0.0" />
		<PackageVersion Include="AspNet.Security.OAuth.Feishu" Version="10.0.0" />
		<PackageVersion Include="AspNet.Security.OpenId.Steam" Version="10.0.0" />
	</ItemGroup>
	<!-- 👇 Redis -->
	<ItemGroup>
		<PackageVersion Include="Aspire.Hosting.Redis" Version="13.4.6" />
		<PackageVersion Include="Aspire.StackExchange.Redis.OutputCaching" Version="13.0.2" />
		<PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.4.6" />
	</ItemGroup>
	<!-- 👇 Quartz -->
	<ItemGroup>
		<PackageVersion Include="Quartz.AspNetCore" Version="3.19.1" />
	</ItemGroup>
	<!-- 👇 Json -->
	<ItemGroup>
		<PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageVersion Include="System.Text.Json" Version="$(Version_NET)" />
	</ItemGroup>
	<!-- 👇 Payment -->
	<ItemGroup>
		<PackageVersion Include="SKIT.FlurlHttpClient.Wechat.Api" Version="3.14.0" />
		<PackageVersion Include="Essensoft.Paylink.Alipay" Version="4.1.9" />
		<PackageVersion Include="Essensoft.Paylink.WeChatPay" Version="4.1.9" />
	</ItemGroup>
	<!-- 👇 Aspire -->
	<ItemGroup>
		<PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
		<PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
		<PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
		<PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
		<PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.6" />
		<PackageVersion Include="Aspire.Hosting.Docker" Version="13.4.6" />
		<PackageVersion Include="Aspire.Hosting.Kubernetes" Version="13.1.0-preview.1.25616.3" />
		<PackageVersion Include="CommunityToolkit.Aspire.Hosting.Meilisearch" Version="13.4.0" />
		<PackageVersion Include="CommunityToolkit.Aspire.Meilisearch" Version="13.4.0" />
		<PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.4.6" />
		<PackageVersion Include="Aspire.RabbitMQ.Client" Version="13.4.6" />
		<PackageVersion Include="Aspire.Hosting.Yarp" Version="13.4.6" />
		<PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.4.6" />
		<PackageVersion Include="RabbitMQ.Client" Version="7.2.0" />
	</ItemGroup>
	<!-- 👇 Docker -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
	</ItemGroup>
	<!-- 👇 Identity -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(Version_NET)" />
		<PackageVersion Include="Microsoft.AspNetCore.Identity.UI" Version="$(Version_NET)" />
	</ItemGroup>
	<!-- 👇 Bcl Compat -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Bcl.Memory" Version="$(Version_NET)" />
	</ItemGroup>
	<!-- 👇 CommandLine -->
	<ItemGroup>
		<PackageVersion Include="System.CommandLine" Version="2.0.11" />
	</ItemGroup>
	<!-- 👇 ReverseProxy -->
	<ItemGroup>
		<PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
	</ItemGroup>
	<!-- 👇 Snowflake Id -->
	<ItemGroup>
		<PackageVersion Include="Yitter.IdGenerator" Version="1.0.14" />
	</ItemGroup>
	<!-- 👇 腾讯云 -->
	<ItemGroup>
		<PackageVersion Include="Tencent.QCloud.Cos.Sdk" Version="5.4.51" />
	</ItemGroup>
	<!-- 👇 Mapper -->
	<ItemGroup>
		<PackageVersion Include="AutoMapper" Version="16.2.0" />
	</ItemGroup>
	<!-- 👇 Base58 -->
	<ItemGroup>
		<PackageVersion Include="SimpleBase" Version="5.6.4" />
	</ItemGroup>
	<!-- 👇 Polly -->
	<ItemGroup>
		<PackageVersion Include="Polly" Version="8.7.0" />
	</ItemGroup>
	<!-- 👇 AngleSharp -->
	<ItemGroup>
		<PackageVersion Include="AngleSharp" Version="1.7.1" />
	</ItemGroup>
	<!-- 👇 Maui -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.20" />
	</ItemGroup>
	<!-- 👇 Magick 图片处理 -->
	<ItemGroup>
		<PackageVersion Include="Magick.NET-Q16-AnyCPU" Version="14.16.0" />
	</ItemGroup>
	<!-- 👇 Steam -->
	<ItemGroup>
		<PackageVersion Include="SteamKit2" Version="3.3.1" />
	</ItemGroup>
	<!-- 👇 Protobuf -->
	<ItemGroup>
		<PackageVersion Include="Google.Protobuf" Version="3.33.3" />
		<PackageVersion Include="Grpc.Tools" Version="2.76.0" />
	</ItemGroup>
	<!-- 👇 Excel -->
	<ItemGroup>
		<PackageVersion Include="ExcelDataReader" Version="3.9.0" />
	</ItemGroup>
	<!-- 👇 AppCenter -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.AppCenter.Analytics" Version="5.0.7" />
		<PackageVersion Include="Microsoft.AppCenter.Crashes" Version="5.0.7" />
	</ItemGroup>
	<!-- 👇 PowerShell -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.PowerShell.5.1.ReferenceAssemblies" Version="1.0.0" />
	</ItemGroup>
	<!-- 👇 Costura.Fody -->
	<ItemGroup>
		<PackageVersion Include="Costura.Fody" Version="6.2.0" />
	</ItemGroup>
	<!-- 👇 SignalR -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="$(Version_NET)" />
	</ItemGroup>
	<!-- 👇 ⬇️ -->
	<ItemGroup>
		<PackageVersion Include="Downloader" Version="5.9.4" />
		<PackageVersion Include="System.Net.Http.WinHttpHandler" Version="$(Version_NET)" />
	</ItemGroup>
	<!-- 👇 DotNext -->
	<ItemGroup>
		<PackageVersion Include="DotNext.Threading" Version="6.6.1" />
	</ItemGroup>
	<!-- 👇 Aprillz.MewUI -->
	<ItemGroup>
		<PackageVersion Include="Aprillz.MewUI.Platform.Win32" Version="0.19.0" />
		<PackageVersion Include="Aprillz.MewUI.Backend.Direct2D" Version="0.19.0" />
	</ItemGroup>
	<!-- 👇 ASP.NET Core OpenId/OAuth -->
	<ItemGroup>
		<PackageVersion Include="OpenIddict.Core" Version="7.6.0" />
		<PackageVersion Include="OpenIddict.Quartz" Version="7.6.0" />
		<PackageVersion Include="OpenIddict.AspNetCore" Version="7.6.0" />
		<PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
		<PackageVersion Include="OpenIddict.EntityFrameworkCore.Models" Version="$(Version_OpenIddict)" />
	</ItemGroup>
</Project>